{
  "name": "@thevtt/desktop",
  "productName": "TheVTT",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "TheVTT — launcher e tavolo virtuale",
  "author": "TheVTT",
  "homepage": "https://github.com/froll0/THEVTT",
  "repository": {
    "type": "git",
    "url": "https://github.com/froll0/THEVTT.git"
  },
  "main": "out/main/index.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "build": "vite build && node scripts/build-electron.mjs",
