{
  "name": "@thevtt/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=esm --external:fastify --external:ws --external:@fastify/cors --outfile=dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "bundle": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/thevtt-server.mjs --banner:js=\"import { createRequire as __cr } from 'node:module'; const require = __cr(import.meta.url);\""
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "fastify": "^5.6.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@thevtt/shared": "workspace:*",
    "@types/ws": "^8.5.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0"
  }
}
